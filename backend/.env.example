NODE_ENV=development
PORT=3000
# Endereço de escuta local. A imagem Docker define 0.0.0.0.
# HTTP_HOST=127.0.0.1
# Chamadas por minuto, compartilhadas pelas rotas /api, por IP e processo (1 a 10000).
HTTP_RATE_LIMIT_MAX=120
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tcc
POSTGRES_USER=tcc_api
POSTGRES_PASSWORD=substitua-pela-senha-do-usuario-de-leitura
# Apenas para testes de integração; usuário capaz de criar banco e role temporários.
# TEST_DATABASE_URL=postgresql://postgres:senha@127.0.0.1:55432/postgres

# Autenticação administrativa (opcional; painel público funciona sem ela)
AUTH_ENABLED=false
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
# Origem exata do navegador: http://127.0.0.1:5173 no pnpm dev (painel e Swagger
# pelo Vite) ou http://127.0.0.1:3000 no pnpm start. localhost é outra origem.
AUTH_ORIGIN=http://127.0.0.1:3000
APP_POSTGRES_USER=tcc_auth
APP_POSTGRES_PASSWORD=
# Somente para comandos de manutenção; não fornecer ao processo HTTP em produção
APP_MIGRATION_USER=tcc_app_owner
APP_MIGRATION_PASSWORD=
