# development habilita o Swagger em /docs. production o desativa e exige
# AUTH_ORIGIN com HTTPS. test é usado pelos testes.
NODE_ENV=development
# Porta HTTP da API (padrão 3000). O proxy do Vite no pnpm dev também a lê.
PORT=3000
# IP em que o servidor escuta. O padrão 127.0.0.1 aceita só conexões da própria
# máquina, e 0.0.0.0 aceita de qualquer interface (a imagem Docker usa esse).
# HTTP_HOST=127.0.0.1
# Requisições por minuto em /api por IP, contadas em cada processo (1 a 10000).
# Quem passa do limite recebe 429.
HTTP_RATE_LIMIT_MAX=120

# Gold: banco da pipeline, lido pelo painel com um usuário só de leitura.
# Host, porta e banco também valem para o schema app da autenticação.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tcc
POSTGRES_USER=tcc_api
POSTGRES_PASSWORD=substitua-pela-senha-do-usuario-de-leitura
# Só para pnpm test:integration: usuário de um PostgreSQL descartável capaz de
# criar e apagar banco e roles temporários. Nunca aponte para a Gold.
# TEST_DATABASE_URL=postgresql://postgres:senha@127.0.0.1:55432/postgres

# Autenticação administrativa. O painel público funciona sem ela. Com true,
# qualquer variável abaixo ausente ou inválida impede a inicialização.
AUTH_ENABLED=false
# Assina os JWTs de acesso. A sessão em si fica no cookie de renovação, gravado
# no banco. Precisa ter pelo menos 64 caracteres hexadecimais. Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
# Origem exata do navegador. POSTs em /api/v1/autenticacao com outro Origin
# recebem 403.
# Use http://127.0.0.1:5173 no pnpm dev ou http://127.0.0.1:3000 no pnpm start;
# localhost conta como outra origem. Em produção, só HTTPS.
AUTH_ORIGIN=http://127.0.0.1:3000
# Role usada pelo servidor no schema app: lê contas e grava sessões, sem criar
# usuários nem alterar tabelas.
APP_POSTGRES_USER=tcc_auth
APP_POSTGRES_PASSWORD=
# Dono do schema app, usado só por db:migrate e auth:criar-admin. Não forneça
# essas variáveis ao processo HTTP em produção.
APP_MIGRATION_USER=tcc_app_owner
APP_MIGRATION_PASSWORD=
