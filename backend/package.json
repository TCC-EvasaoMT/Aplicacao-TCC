{
	"name": "tcc-evasao-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"db:migrate": "node --env-file-if-exists=.env --import tsx src/database/cli.ts migrar",
		"auth:criar-admin": "node --env-file-if-exists=.env --import tsx src/database/cli.ts criar-admin",
		"dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/server.js --serve-frontend",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test test/*.test.ts",
		"test:integration": "node --env-file-if-exists=.env --import tsx --test test/integration/*.test.ts"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.5",
		"@fastify/helmet": "^13.2.0",
		"@fastify/jwt": "^10.2.8",
		"@fastify/rate-limit": "^11.3.0",
		"@fastify/static": "^8.3.0",
		"@fastify/swagger": "^9.9.5",
		"@fastify/swagger-ui": "^5.2.6",
		"argon2": "^0.45.2",
		"fastify": "^5.12.8",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
